[Unit]
Description=gh-mirror 多服务加速网关（Docker / GitHub / HuggingFace + MCP）
After=network.target

[Service]
Type=simple
User=ghmirror
Group=ghmirror
WorkingDirectory=/opt/gh-mirror
# 配置（含管理员账号密码、会话密钥、token 文件路径）写入 /etc/gh-mirror.env
EnvironmentFile=/etc/gh-mirror.env
ExecStart=/opt/gh-mirror/gh-mirror
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
