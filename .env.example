# gh-mirror 通用 Docker 部署环境变量
# cp 为 .env 后填写 ADMIN_PASS 与 ADMIN_SECRET
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password
ADMIN_PATH=/admin
# 32 位十六进制随机串：openssl rand -hex 32
ADMIN_SECRET=replace-with-openssl-rand-hex-32
CACHE_TTL_MINUTES=1440
MAX_CACHE_MB=200
UPSTREAM_TIMEOUT=60

# —— 以下为按需可选 ——
# HTTPS 部署保持 true；纯 HTTP（无 TLS）部署改为 false，否则浏览器不下发 Secure cookie 导致后台无法登录
COOKIE_SECURE=true
# 场景 A（docker-compose.publish.yml）：网关暴露到宿主机的绑定地址与端口
GM_BIND_ADDR=127.0.0.1
GM_HTTP_PORT=8080
# 如需避免容器名与现有容器冲突，可改这两个名字
# GH_MIRROR_CONTAINER_NAME=gh-mirror
# NGINX_CONTAINER_NAME=gh-mirror-nginx
# 要开放 HuggingFace 代理：HF_ENABLED=true
