# gh-mirror 通用 Docker 部署环境变量（**环境变量的唯一权威白名单**）
# 用法：cp 为 .env 后，至少填写 ADMIN_PASS 与 ADMIN_SECRET
#
# ⚠️ 主服务真实生效的变量只有下面这些（由 config 包的 applyEnv 读取）。
#    网上 / 某些 AI 自动生成配置里出现的大批 GM_DATA_DIR、GM_PROXY_MAX_*、
#    GM_PROXY_MAX_PROXY_*、GM_ALLOWED_NETWORKS、GM_ADMIN_PASSWORD，
#    以及 GHW-MODE / GHW-DB / GHW-DATA-DIR / GHW-USER-MAX-CONC 等——
#    程序一律不读取，纯属幻觉，写了等于没写（明文密码还泄露）。
#
#    规则：
#    1. 只允许使用本文件列出的变量；此外一律视为不存在。
#    2. 不确定某个变量是否存在时，先 grep config/config.go 确认，
#       绝不用自己编的名字填空（不要发明 GM_* / GHW_* / GH_* 等前缀）。
#    3. gh-mirror 没有「并发数 / 线程数 / 连接数 / 运行模式 / 数据库 / 最大用户」
#       这类环境变量：限流用 RATELIMIT_ENABLED；限制内存/CPU 用 docker 层面
#       （compose 的 mem_limit / cpus），不是程序环境变量。
#    唯一以 GM_ 开头的是 GM_MCP_TOKEN，仅用于 `gh-mirror mcp` 子命令，与主服务无关。

# —— 必填 ——
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password          # 改成强密码
ADMIN_PATH=/admin
# 32 位十六进制随机串：openssl rand -hex 32（会话签名密钥，务必随机）
ADMIN_SECRET=replace-with-openssl-rand-hex-32

# —— 多用户（可选，删除则关闭普通用户入口）——
USER_PATH=/user

# —— 网络 / 存储（可选，有默认值）——
LISTEN=127.0.0.1:8080                         # 容器内监听地址（standalone.yml 已内置）
CACHE_DIR=/var/cache/gh-mirror
TOKENS_FILE=/var/lib/gh-mirror/tokens.json

# —— 缓存 / 上游（可选，有默认值）——
CACHE_TTL_MINUTES=1440        # 缓存 TTL（分钟）
MAX_CACHE_MB=200              # 缓存容量上限（MB），超出按 LRU + 三级清理
UPSTREAM_TIMEOUT=60           # 上游超时（秒）

# —— 按需可选 ——
# 纯 HTTP（无 TLS）部署改为 false，否则浏览器不下发 Secure cookie 导致后台无法登录
COOKIE_SECURE=true
# 开启 Docker 镜像加速：DOCKER_ENABLED=true
# 开放 HuggingFace 代理：HF_ENABLED=true
# 启用 jsDelivr 边缘缓存公开仓库文件：USE_JSDELIVR=true
# 开启全局速率限制：RATELIMIT_ENABLED=true
# 出网走 SOCKS5 代理：UPSTREAM_SOCKS5=socks5://127.0.0.1:1080

# —— 仅 docker-compose.publish.yml 覆盖层使用的 compose 变量（非程序 env）——
# 仅供 compose 变量替换，不要把 GM_ 开头的名字写进容器的 environment 段；
# standalone.yml 已内置 127.0.0.1:8080，通常无需此项
# GM_BIND_ADDR=127.0.0.1
# GM_HTTP_PORT=8080
