[Unit]
Description=GitHub Mirror Proxy
After=network.target

[Service]
Type=simple
User=ghmirror
Group=ghmirror
WorkingDirectory=/opt/github-mirror
# 配置（含管理员账号密码、会话密钥、token 文件路径）写入 /etc/github-mirror.env
EnvironmentFile=/etc/github-mirror.env
ExecStart=/opt/github-mirror/github-mirror
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
