# gh-mirror 通用 Docker 部署环境变量
# 复制为 .env 后，至少填写 ADMIN_PASS 与 ADMIN_SECRET
#
# ⚠️ 仅下方列出的变量被主服务读取（完整白名单见根目录 .env.example）。
#    不要写 GM_DATA_DIR / GM_PROXY_* / GHW-MODE / GHW-DB / GHW-DATA-DIR / GHW-USER-MAX-CONC
#    等任何非白名单前缀变量：程序不认，纯属幻觉配置（明文密码还泄露）。
#    唯一 GM_ 开头的是 GM_MCP_TOKEN（仅 mcp 子命令）。
#    需要限流用 RATELIMIT_ENABLED；限制内存/CPU 用 docker 层面（mem_limit / cpus），
#    不是程序环境变量。不确定时先 grep config/config.go 确认，不要自己编名字。

ADMIN_USER=admin
# 后台管理员密码（请改成强密码）
ADMIN_PASS=change-me-strong-password
ADMIN_PATH=/admin
# 32 位十六进制随机串，生成命令: openssl rand -hex 32
ADMIN_SECRET=replace-with-openssl-rand-hex-32

# 普通用户入口（多用户）：设 /user 开启，删除则关闭
USER_PATH=/user

# 网络 / 存储（可选，有默认值）
LISTEN=127.0.0.1:8080
CACHE_DIR=/var/cache/gh-mirror
TOKENS_FILE=/var/lib/gh-mirror/tokens.json

CACHE_TTL_MINUTES=1440
MAX_CACHE_MB=200
UPSTREAM_TIMEOUT=60

# 纯 HTTP 部署改为 false；开放 HF 代理加 HF_ENABLED=true
COOKIE_SECURE=true
# 开启 Docker 镜像加速：DOCKER_ENABLED=true
# 开启全局速率限制：RATELIMIT_ENABLED=true
